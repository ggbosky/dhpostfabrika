# --- Jediný potřebný klíč (ZDARMA) ---
# Google AI Studio: https://aistudio.google.com/apikey -> "Create API key"
GEMINI_API_KEY=

# --- Volitelné ---
# Model Gemini. "gemini-flash-latest" = vždy aktuální Flash model z free tieru.
# Dostupné modely vypíše: python -m postfabrika modely
# GEMINI_MODEL=gemini-flash-latest

# Filtr licence fotek z DuckDuckGo:
#   upravy   = volně použitelné komerčně vč. úprav (výchozí, nejbezpečnější)
#   komercni = volně šiřitelné komerčně
#   verejne  = public domain
#   vse      = bez filtru (nejvíc fotek, ale většinou chráněné autorským právem!)
# FOTO_LICENCE=upravy

# Region vyhledávání (wt-wt = celosvětově, cz-cs = Česko)
# HLEDANI_REGION=wt-wt

# Přidat do textu postu zdroj fotky ("📸 Foto: web.cz"), 1 = ano, 0 = ne
# PRIDAT_ZDROJ_FOTA=1

# Cesta k tučnému TTF fontu s českou diakritikou pro titulek v obrázku
# FONT_PATH=C:\Windows\Fonts\arialbd.ttf

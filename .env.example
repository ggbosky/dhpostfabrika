# --- Povinné ---
# Klíč ke Claude API: https://console.anthropic.com/  (alternativně `ant auth login`)
ANTHROPIC_API_KEY=

# --- Fotobanky (stačí aspoň jedna, ideálně obě) ---
# Pexels: https://www.pexels.com/api/  (zdarma)
PEXELS_API_KEY=
# Unsplash: https://unsplash.com/developers  -> "Access Key" (zdarma)
UNSPLASH_ACCESS_KEY=

# --- Volitelné ---
# Model Claude (výchozí claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Přidat do textu postu kredit fotografa (1 = ano, 0 = ne). Unsplash ho výslovně žádá.
# PRIDAT_KREDIT_FOTA=1
# Cesta k tučnému TTF fontu s českou diakritikou pro titulek v obrázku (--titulek-v-obrazku)
# FONT_PATH=C:\Windows\Fonts\arialbd.ttf
